# Copy this file to .env and replace credentials/placeholders before starting.
# Docker Compose reads this file from the repository root.

# Application URLs and server
HOST_FRONTEND=http://localhost:4200
APP_NAME=Task App
PORT=3000
HOST_API=http://localhost:3000/api/v1
TRUST_PROXY=loopback

# PostgreSQL as seen by the backend container (service name + container port).
# Keep the database/user/password aligned with POSTGRES_* below.
TORM_PG_HOST=postgres
TORM_PG_DATABASE=task_app_dev
TORM_PG_USER_DB=task_app_user
TORM_PG_PASSWORD_DB=<CHANGE_ME_DATABASE_PASSWORD>
TORM_PG_PORT=5432

# Authentication secrets: generate unique random values; never use these placeholders.
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_SECRET=<GENERATE_ANOTHER_LONG_RANDOM_SECRET>

# SMTP (required for email delivery; configure with your provider's credentials).
MAILER_HOST=smtp.gmail.com
MAILER_PORT=465
MAILER_USER=<YOUR_SMTP_EMAIL>
MAILER_SECRET=<YOUR_SMTP_APP_PASSWORD>

# pgAdmin
PG_ADMIN_EMAIL=<YOUR_PGADMIN_EMAIL>
PGADMIN_PASSWORD=<CHANGE_ME_PGADMIN_PASSWORD>

# PostgreSQL container. These must match TORM_PG_* above.
POSTGRES_USER=task_app_user
POSTGRES_PASSWORD=<CHANGE_ME_DATABASE_PASSWORD>
POSTGRES_DB=task_app_dev

# OAuth credentials (optional until you configure the corresponding providers).
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=<YOUR_MICROSOFT_CLIENT_ID>
MICROSOFT_CLIENT_SECRET=<YOUR_MICROSOFT_CLIENT_SECRET>
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback
